  "dialogues": [
    {
      "number": 1,
      "title": "Meeting Someone New",
      "situation_en": "Omar has just started a new job. Sara works in the same office. They meet in the corridor.",
      "situation_ar": "عمر بدأ وظيفة جديدة. سارة تعمل في نفس المكتب. يلتقيان في الممر.",
      "lines": [
        { "speaker": "SARA", "en": "Good morning! Are you the new engineer?", "ar": "صباح الخير! هل أنت المهندس الجديد؟" },
        { "speaker": "OMAR", "en": "Yes, I am. My name is Omar.", "ar": "نعم، أنا هو. اسمي عمر." },
        { "speaker": "SARA", "en": "Nice to meet you, Omar. I'm Sara.", "ar": "سعيدة بلقائك يا عمر. أنا سارة." },
        { "speaker": "OMAR", "en": "Nice to meet you too. Sorry, how do you spell your name?", "ar": "وأنا سعيد بلقائك أيضاً. عذراً، كيف تتهجين اسمك؟" },
        { "speaker": "SARA", "en": "S–A–R–A. And you? Where are you from?", "ar": "س ا ر ا. وأنت؟ من أين أنت؟" },
        { "speaker": "OMAR", "en": "I'm from Egypt. I'm from Alexandria.", "ar": "أنا من مصر. أنا من الإسكندرية." },
        { "speaker": "SARA", "en": "Oh, nice! Is Alexandria a big city?", "ar": "رائع! هل الإسكندرية مدينة كبيرة؟" },
        { "speaker": "OMAR", "en": "Yes, it is. It's very big. Are you from here?", "ar": "نعم. إنها كبيرة جداً. هل أنت من هنا؟" },
        { "speaker": "SARA", "en": "No, I'm not. I'm from Jordan.", "ar": "لا، لست كذلك. أنا من الأردن." },
        { "speaker": "OMAR", "en": "Sorry, could you repeat that?", "ar": "عذراً، هل يمكنك إعادة ذلك؟" },
        { "speaker": "SARA", "en": "Of course. I'm from Jordan.", "ar": "بالطبع. أنا من الأردن." },
        { "speaker": "OMAR", "en": "Ah, I understand. Thank you!", "ar": "آه، فهمت. شكراً لك!" }
      ]
    },
    {
      "number": 2,
      "title": "Talking About Family",
      "situation_en": "Later, in the office kitchen. Sara asks Omar about his family.",
      "situation_ar": "لاحقاً، في مطبخ المكتب. سارة تسأل عمر عن عائلته.",
      "lines": [
        { "speaker": "SARA", "en": "Is this a photo of your family?", "ar": "هل هذه صورة لعائلتك؟" },
        { "speaker": "OMAR", "en": "Yes, it is. This is my wife, Mona.", "ar": "نعم. هذه زوجتي، منى." },
        { "speaker": "SARA", "en": "She's very beautiful. Is she a doctor?", "ar": "إنها جميلة جداً. هل هي طبيبة؟" },
        { "speaker": "OMAR", "en": "No, she isn't. She's a teacher.", "ar": "لا، ليست كذلك. إنها معلّمة." },
        { "speaker": "SARA", "en": "And are these your children?", "ar": "وهل هؤلاء أطفالك؟" },
        { "speaker": "OMAR", "en": "Yes, they are. This is my son, Adam. He's six.", "ar": "نعم. هذا ابني آدم. عمره ست سنوات." },
        { "speaker": "SARA", "en": "He's lovely! And your daughter?", "ar": "إنه لطيف! وابنتك؟" },
        { "speaker": "OMAR", "en": "Her name is Lina. She's three years old.", "ar": "اسمها لينا. عمرها ثلاث سنوات." },
        { "speaker": "SARA", "en": "Are your parents here in the city too?", "ar": "هل والداك هنا في المدينة أيضاً؟" },
        { "speaker": "OMAR", "en": "No, they aren't. They're in Alexandria.", "ar": "لا، ليسا كذلك. إنهما في الإسكندرية." },
        { "speaker": "SARA", "en": "Do you miss them?", "ar": "هل تشتاق إليهما؟" },
        { "speaker": "OMAR", "en": "Yes, very much. But we speak every day.", "ar": "نعم، كثيراً جداً. لكننا نتحدث كل يوم." }
      ]
    }
  ],

