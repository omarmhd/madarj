  "title_en": "Sounds, Greetings & Introducing Yourself",
  "title_ar": "الأصوات والتحيات والتعريف بالنفس",
  "pron_section": 8,
  "is_review": false,

  "objectives": [
    { "en": "Greet someone and respond appropriately at any time of day", "ar": "تحيّي شخصاً وتردّ بشكل مناسب في أي وقت من اليوم" },
    { "en": "Say my name, age, city, country and job in full sentences", "ar": "تقول اسمك وعمرك ومدينتك وبلدك ووظيفتك بجمل كاملة" },
    { "en": "Ask another person those same five questions", "ar": "تسأل شخصاً آخر نفس الأسئلة الخمسة" },
    { "en": "Name and describe the members of my family", "ar": "تسمّي أفراد عائلتك وتصفهم" },
    { "en": "Say and understand numbers 1–1000, days and months", "ar": "تقول وتفهم الأرقام والأيام والشهور" },
    { "en": "Use am / is / are correctly in positive, negative and question forms", "ar": "تستخدم am/is/are في الإثبات والنفي والسؤال" },
    { "en": "Hear the difference between ship and sheep, full and fool", "ar": "تسمع الفرق بين ship و sheep" },
    { "en": "Ask for help in English when I do not understand", "ar": "تطلب المساعدة بالإنجليزية عندما لا تفهم" },
    { "en": "Speak about myself for 90 seconds without stopping", "ar": "تتحدث عن نفسك 90 ثانية بلا توقف" },
    { "en": "Write a 60-word introduction of myself", "ar": "تكتب تعريفاً بنفسك في 60 كلمة" }
  ],

