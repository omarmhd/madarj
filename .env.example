APP_NAME=Madarij
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is for local work only. Production runs MySQL 8 — see
# docs/02-setup.md. The two differ in ways that do not surface until
# you run on MySQL: it has no CREATE INDEX IF NOT EXISTS, no backslash
# escape in string literals, and TIMESTAMP stops in 2038.
DB_CONNECTION=sqlite

# MySQL 8.0.13 or newer — the vocabulary index needs functional indexes,
# and the collation must be utf8mb4 for Arabic.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=madarij
# DB_USERNAME=madarij
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# كافي: الترجمة الآلية للكلمات التي ليست في مفردات الكتاب.
# أطفئها فيبقى الدفتر ويكتب المتدرّب المعنى بيده.
MEMORY_TRANSLATE=true

# Development only: opens every week and day without touching progress.
# Ignored when APP_ENV=production, whatever this says.
UNLOCK_ALL_WEEKS=false
